<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- NU5128: a package with dependencies but no lib/ folder. Build-only by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>Concertable .NET build law: the test-tier gate and both banned-symbol lists, delivered to a consuming repository as MSBuild props/targets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" />
  </ItemGroup>

  <!-- The law files live at the repository root, where this repository's own projects consume them
       directly. Packing them into build/ is what gives every other repository the same files from
       one owner rather than a copy that drifts. -->
  <ItemGroup>
    <None Include="build/Concertable.Build.props" Pack="true" PackagePath="build/" />
    <None Include="build/Concertable.Build.targets" Pack="true" PackagePath="build/" />
    <None Include="../../TestConventions.targets" Pack="true" PackagePath="build/" />
    <None Include="../../BannedSymbols.txt" Pack="true" PackagePath="build/" />
    <None Include="../../BannedSymbols.UnitTests.txt" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
